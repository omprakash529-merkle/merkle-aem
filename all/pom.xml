<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.merkle</groupId>
        <artifactId>merkle-aem</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>merkle-aem.all</artifactId>
    <packaging>content-package</packaging>
    <name>Merkle - All</name>
    <description>Container package that embeds all modules for deployment</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <group>com.merkle</group>
                    <name>merkle-aem.all</name>
                    <packageType>container</packageType>
                    <embeddeds>
                        <embedded>
                            <groupId>com.merkle</groupId>
                            <artifactId>merkle-aem.ui.apps.structure</artifactId>
                            <type>zip</type>
                            <target>/apps/merkle-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.merkle</groupId>
                            <artifactId>merkle-aem.core</artifactId>
                            <target>/apps/merkle-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.merkle</groupId>
                            <artifactId>merkle-aem.ui.apps</artifactId>
                            <type>zip</type>
                            <target>/apps/merkle-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.merkle</groupId>
                            <artifactId>merkle-aem.ui.config</artifactId>
                            <type>zip</type>
                            <target>/apps/merkle-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.merkle</groupId>
                            <artifactId>merkle-aem.ui.content</artifactId>
                            <type>zip</type>
                            <target>/apps/merkle-packages/content/install</target>
                        </embedded>
                    </embeddeds>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.merkle</groupId>
            <artifactId>merkle-aem.ui.apps.structure</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.merkle</groupId>
            <artifactId>merkle-aem.core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.merkle</groupId>
            <artifactId>merkle-aem.ui.apps</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.merkle</groupId>
            <artifactId>merkle-aem.ui.config</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.merkle</groupId>
            <artifactId>merkle-aem.ui.content</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
    </dependencies>
</project>
